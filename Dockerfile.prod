# Production image. Build stages install every dependency (dev included) to lint
# and compile; the runtime stage only carries the Next.js standalone output
# (server.js plus the traced node_modules), .next/static and public/.

# Base: Node + pnpm for the build stages
FROM node:24-bookworm-slim AS base
RUN npm i -g pnpm@11.1.3
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1


# Deps: every dependency, needed to build
FROM base AS deps
# pnpm-workspace.yaml carries allowBuilds for the native build scripts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile


# Build: lint and compile
FROM deps AS build
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so they
# come in as build args (the runtime environment cannot change them)
ARG NEXT_PUBLIC_GATEWAY_WS_URL=http://localhost:3000
ENV NEXT_PUBLIC_GATEWAY_WS_URL=${NEXT_PUBLIC_GATEWAY_WS_URL}
COPY . .
RUN pnpm lint && pnpm build


# Runtime (default target)
FROM node:24-bookworm-slim AS prod
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    # Docker sets HOSTNAME to the container id; server.js listens on it
    HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3001
CMD ["node", "server.js"]
